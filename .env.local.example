# Iz Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tvoj-anon-ili-publishable-kljuc

# Push obaveštenja (korak 6b)
# Ključevi za obaveštenja: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=javni-kljuc
VAPID_PRIVATE_KEY=privatni-kljuc
# Iz Supabase: Project Settings → API Keys → Secret keys (sb_secret_...). NIKAD sa NEXT_PUBLIC_ ispred!
SUPABASE_SECRET_KEY=sb_secret_...
